# Copy this file to .env and replace placeholders with your own settings.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=fridge-pi-controller

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iot
DB_USER=your_db_username
DB_PASSWORD=replace_with_your_database_password

# SMTP/IMAP example settings for Gmail. Use an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=yourname@gmail.com
EMAIL_PASSWORD=replace_with_your_gmail_app_password
ALERT_TO=recipient@example.com
ALLOWED_REPLY_FROM=recipient@example.com

# GPIO settings
MOTOR_ENABLE_PIN=22
MOTOR_IN1_PIN=27
MOTOR_IN2_PIN=17
SIMULATE_MOTOR=1

# Alert cooldown in seconds to avoid repeatedly emailing while the same fridge stays warm.
ALERT_COOLDOWN_SECONDS=900
EMAIL_POLL_SECONDS=20
